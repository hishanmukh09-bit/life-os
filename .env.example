# Database connection string (PostgreSQL for production, SQLite supported locally)
DATABASE_URL="file:./dev.db"

# Session Authentication Secret
AUTH_SECRET="super-secret-life-os-encryption-key-change-in-production"

# AI Integration (OpenAI or Gemini API key, fallback heuristic engine enabled when absent)
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Application Host URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Cloud Storage (e.g. Supabase / AWS S3 / Cloudflare R2)
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Web Push Notification VAPID Keys (Optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
